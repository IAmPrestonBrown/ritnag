{
  "name": "imp",
  "private": true,
  "version": "0.1.0",
  "description": "Ritnag: a mischievous desktop companion that remembers your answers and handles repeat interruptions.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch --clear-screen=false server/index.ts",
    "build": "vite build",
    "start": "NODE_ENV=production tsx server/index.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "voice:model": "tsx server/voice/fetchModel.ts",
    "check": "npm run typecheck && npm test && npm run build",
    "bakeoff": "tsx scripts/bakeoff/run.ts",
    "smoke:voice": "tsx scripts/voice-smoke.ts",
    "director": "tsx scripts/director/cli.ts",
    "director:transcribe": "tsx scripts/director/transcribe.ts",
    "director:record": "tsx scripts/director/record.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@moss-js/moss": "^1.21.0",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sherpa-onnx-node": "1.13.8",
    "ws": "^8.22.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.2",
    "puppeteer-core": "^24.43.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
