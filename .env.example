# Copy to .env and fill in. Never commit .env.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
# low | medium | high — low keeps the decision call fast
ANTHROPIC_EFFORT=low
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3
# ms of silence before Deepgram ends an utterance; lower = faster, higher = fewer mid-sentence splits
DEEPGRAM_ENDPOINTING_MS=500
CARTESIA_API_KEY=
CARTESIA_MODEL=sonic-3.6
CARTESIA_VOICE_ID=
# Moss semantic search (moss.dev). Server-side only.
MOSS_PROJECT_ID=
MOSS_PROJECT_KEY=
MOSS_INDEX_NAME=imp-memories
OWNER_NAME=Preston
# Owner voice verification (docs/SPEAKER_ID.md). The model downloads to data/models on first use,
# or ahead of time with `npm run voice:model`. Set this only to use a model file you provide.
# VOICE_MODEL_PATH=
PORT=3000
# Speaker-ID bake-off / realtime speaker identification (docs/WORKSTREAMS.md P1–P2)
SPEECHMATICS_API_KEY=