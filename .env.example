# Copy to .env and fill in. Never commit .env.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# low | medium | high — low keeps the decision call fast
ANTHROPIC_EFFORT=low
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3
CARTESIA_API_KEY=
CARTESIA_MODEL=sonic-3.6
CARTESIA_VOICE_ID=
# Moss semantic search (moss.dev). Server-side only.
MOSS_PROJECT_ID=
MOSS_PROJECT_KEY=
MOSS_INDEX_NAME=imp-memories
OWNER_NAME=Preston
PORT=3000
